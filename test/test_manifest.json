            "research_store_workflow",
            "shape_not_lines_examples",
            "layered_pack_output"
          ]
        },
        {
          "id": "extract-persona",
          "script": "extract_persona_test.py",
          "what_it_checks": [
            "source_store_provenance_and_dedupe",
            "speaker_attribution",
            "incremental_index_stable_ids",
            "coverage_gate",
            "stylometry_signature_phrases",
            "bm25_retrieval_budget",
