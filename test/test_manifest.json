{
  "categories": {
    "static": {
      "description": "Fast local checks that do not call model APIs.",
      "tests": [
        {
          "id": "package",
          "script": "package_test.py",
          "what_it_checks": [
            "codex_manifest",
            "release_metadata",
            "command_adapters",
            "active_persona_bundle"
          ]
        },
        {
          "id": "claude-plugin",
          "script": "claude_plugin_test.py",
          "what_it_checks": [
            "claude_manifest",
            "marketplace_manifest",
            "packaged_skill_layout"
          ]
        },
        {
          "id": "personality-pack-contract",
          "script": "personality_pack_contract_test.py",
          "what_it_checks": [
            "active_pack_schema",
            "duplicate_ids",
            "forbidden_guardrail_fields",
            "archive_exclusion"
          ]
        },
        {
          "id": "behavior",
          "script": "behavior_test.py",
          "what_it_checks": [
            "packet_composition",
            "activation_packet",
            "entrypoint_skill_contract",
            "task_persona_separation"
          ]
        },
        {
          "id": "extractor",
          "script": "extractor_test.py",
          "what_it_checks": [
            "research_backed_pack_creation_guidance"
          ]
        }
      ]
    },
    "live": {
      "description": "Model-based comparisons. These require provider API keys unless run with --dry-run.",
      "tests": [
        {
          "id": "live-model-dry-run",
          "script": "live_model_test.py --dry-run",
          "what_it_checks": [
            "packet_loadability",
            "configured_api_surface"
          ]
        },
        {
          "id": "jesse-style",
          "script": "jesse_style_test.py",
          "persona": "jesse-pinkman",
          "cases": "jesse_cases.json",
          "what_it_checks": [
            "voice",
            "vocabulary",
            "emotional_poles",
            "sentence_structure"
          ]
        },
        {
          "id": "sam-style",
          "script": "sam_style_test.py",
          "persona": "sam-harris",
          "cases": "sam_cases.json",
          "what_it_checks": [
            "analytic_structure",
            "fact_vs_inference",
            "tradeoff_framing"
          ]
        },
        {
          "id": "yoda-style",
          "script": "yoda_style_test.py",
          "persona": "yoda",
          "cases": "yoda_cases.json",
          "what_it_checks": [
            "fronted_emphasis",
            "aphoristic_compression",
            "wisdom_first_reframing",
            "speech_inversion"
          ]
        }
      ]
    }
  },
  "known_gaps": [
    "No live style/evaluation suites yet for bjarne-stroustrup, dababy, or hikaru-nakamura.",
    "No model-based repetition-control suite yet.",
    "No source-grounding judge yet for quote/trait mapping."
  ],
  "versioning": {
    "convention": "semver pre-1.0: v0.MINOR.PATCH",
    "minor_bump_triggers": [
      "new persona added",
      "new capability class",
      "core architecture change"
    ],
    "patch_bump_triggers": [
      "pack refinement",
      "test fix or new test case",
      "documentation update"
    ],
    "tags": {
      "v0.1.0": "initial Codex-ready skill packaging baseline",
      "v0.2.0": "personify plugin: portable persona source and host package generators",
      "v0.3.0": "persona activation packet, source workflow repackaging, CI artifact publishing",
      "v0.3.1": "reduce persona repetition traps, block mechanical repetition in contract test",
      "v0.4.0": "yoda style test runner, versioning enforcement hook and CI check"
    }
  }
}
