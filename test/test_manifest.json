            "yaml_round_trip",
            "offline_only"
          ]
        }
      ]
    },
    "live": {
      "description": "Model-based comparisons. These require provider API keys unless run with --dry-run.",
      "tests": [
        {
          "id": "live-model-dry-run",
          "script": "live_model_test.py --dry-run",
          "what_it_checks": [
            "packet_loadability",
            "configured_api_surface"
          ]
        },
        {
          "id": "activation-benchmark",
          "script": "activation_benchmark.py",
          "what_it_checks": [
            "neutral_baseline",
            "plain_prepend_baseline",
            "pap_self_check",
            "pap_advantage_judging"
          ]
        },
        {
          "id": "jesse-style",
          "script": "jesse_style_test.py",
          "persona": "jesse-pinkman",
          "cases": "jesse_cases.json",
          "what_it_checks": [
            "voice",
            "vocabulary",
            "emotional_poles",
            "sentence_structure"
          ]
        },
        {
          "id": "sam-style",
          "script": "sam_style_test.py",
          "persona": "sam-harris",
          "cases": "sam_cases.json",
          "what_it_checks": [
            "analytic_structure",
            "fact_vs_inference",
            "tradeoff_framing"
          ]
        },
        {
          "id": "yoda-style",
          "script": "yoda_style_test.py",
          "persona": "yoda",
          "cases": "yoda_cases.json",
          "what_it_checks": [
            "fronted_emphasis",
            "aphoristic_compression",
            "wisdom_first_reframing",
            "speech_inversion"
          ]
        }
      ]
    }
  },
  "known_gaps": [
    "No live style/evaluation suites yet for dababy or hikaru-nakamura.",
    "No model-based repetition-control suite yet.",
    "No source-grounding judge yet for quote/trait mapping.",
    "No model-based comparison yet of v2 (layered, retrieval-backed) packs against v1 packs; v2 fidelity gains are untested.",
    "Several bundled packs are not strict YAML (PyYAML rejects george-hotz, hikaru-nakamura, jesse-pinkman, leon; dababy has list items that strict YAML reads as maps). Repo parsers are line-based so this is latent; `persona_extract.py migrate` rewrites a pack as strict YAML."
  ],
  "versioning": {
    "convention": "semver pre-1.0: v0.MINOR.PATCH",
    "minor_bump_triggers": [
      "new persona added",
      "new capability class",
      "core architecture change"
    ],
    "patch_bump_triggers": [
      "pack refinement",
      "test fix or new test case",
      "documentation update"
    ],
    "tags": {
      "v0.1.0": "initial Codex-ready skill packaging baseline",
      "v0.2.0": "personify plugin: portable persona source and host package generators",
      "v0.3.0": "persona activation packet, source workflow repackaging, CI artifact publishing",
      "v0.3.1": "reduce persona repetition traps, block mechanical repetition in contract test",
      "v0.4.0": "yoda style test runner, versioning enforcement hook and CI check",
      "v0.5.0": "activation benchmark reporting, bundled persona curation, and george-hotz draft pack",
      "v0.6.0": "extract-persona v2: research store + chunked/utterance corpus, stylometry, BM25 retrieval, layered token-budgeted pack schema v2 with JSON Schema, v1 migration"
    }
  }
}
