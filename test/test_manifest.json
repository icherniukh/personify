          "what_it_checks": [
            "codex_manifest",
            "release_metadata",
            "command_adapters",
            "active_persona_bundle"
          ]
        },
        {
          "id": "claude-plugin",
          "script": "claude_plugin_test.py",
          "what_it_checks": [
            "claude_manifest",
            "marketplace_manifest",
            "packaged_skill_layout"
          ]
        },
        {
          "id": "personality-pack-contract",
          "script": "personality_pack_contract_test.py",
          "what_it_checks": [
            "active_pack_schema",
            "duplicate_ids",
            "forbidden_guardrail_fields",
            "archive_exclusion",
            "json_schema_v1_v2"
          ]
        },
        {
          "id": "behavior",
          "script": "behavior_test.py",
          "what_it_checks": [
            "packet_composition",
            "activation_packet",
            "entrypoint_skill_contract",
            "task_persona_separation"
          ]
        },
        {
          "id": "extractor",
